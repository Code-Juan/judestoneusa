# Server Configuration
PORT=3000
NODE_ENV=development

# Postmark Email Configuration
# Without POSTMARK_API_KEY the order desk still validates and responds,
# but logs the submission instead of sending it.
POSTMARK_API_KEY=your_postmark_server_token_here
POSTMARK_FROM_EMAIL=noreply@judestoneusa.com
POSTMARK_TO_EMAIL=info@judestoneusa.com

# CORS Configuration
CORS_ORIGIN=http://localhost:8000

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Spam trap: the form renders a hidden field with this name that must stay empty
HONEYPOT_FIELD_NAME=website
